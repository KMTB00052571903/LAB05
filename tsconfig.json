{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "node",
      "strict": true,
      "jsx": "preserve",
      "sourceMap": true,
      "outDir": "./dist",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "baseUrl": "./src",
      "paths": {
        "@/*": ["./*"],
        "@components/*": ["./components/*"],
        "@store/*": ["./store/*"],
        "@models/*": ["./models/*"]
      },
      "lib": ["ESNext", "DOM"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
  }